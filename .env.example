NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_q
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# AI (Google Gemini)
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemini-flash-latest

# Google OAuth (FS-009: Gmail 연동)
# Google Cloud Console에서 OAuth 클라이언트 생성 후 채워넣기. 승인된 리디렉션 URI에
# 아래 GOOGLE_REDIRECT_URI 값을 그대로 등록해야 함.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
