{
  "name": "project-q-backend",
  "version": "0.1.0",
  "private": true,
  "description": "멋사 중앙 해커톤 - 조직/직무 맞춤형 메시지 변환 서비스 백엔드",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon -e js,json,env src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-isolation=none",
    "test:db:messages": "node src/scripts/verifyMessageModels.js",
    "test:integration:optimize": "node src/scripts/verifyMessageOptimization.js",
    "test:db:team-memory": "node src/scripts/verifyTeamMemory.js",
    "test:db:gmail": "node src/scripts/verifyGmailIntegration.js",
    "db:seed": "node src/scripts/seedDemo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "mammoth": "^1.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "pdf-parse": "^2.4.5",
    "sequelize": "^6.37.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
